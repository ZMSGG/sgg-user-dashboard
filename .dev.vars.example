# Local-only development values. Never commit populated secrets.
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_IDS=
# Guild membership sync (optional feature; fails closed when unset).
# Bot token of the approved SGG Discord application; the bot must be in the guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Separate >=32-byte secret used only to HMAC Discord DM one-time codes and
# rate-limit subjects. Opaque challenge IDs/nonces are SHA-256 digested.
DM_OTP_PEPPER=
# Server-to-server automated point grants (optional feature; fails closed when unset).
# Secret: >=32 bytes, shared only with approved game/campaign backends.
# Actor: the Discord user ID of the service's bot user, recorded as granted_by.
INTEGRATION_GRANT_SECRET=
INTEGRATION_ACTOR_ID=
# OTOMO CHAIN 7 tournament reconciliation (optional; fails closed when unset).
# HTTPS reward-export endpoint and its admin secret. Read-only: the dashboard
# never writes to the game. external_id is exposed on this endpoint only.
OTOMO_CHAIN_EXPORT_URL=
OTOMO_CHAIN_ADMIN_SECRET=
# Pre-entry roster endpoint (optional). Same admin secret; supplies the
# game-verified Discord IDs used as the strongest identity source.
OTOMO_CHAIN_PREENTRY_URL=
