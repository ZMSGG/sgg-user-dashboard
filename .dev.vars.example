# Local-only development values. Never commit populated secrets.
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_IDS=
# Guild membership sync (optional feature; fails closed when unset).
# Bot token of the approved SGG Discord application; the bot must be in the guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Server-to-server automated point grants (optional feature; fails closed when unset).
# Secret: >=32 bytes, shared only with approved game/campaign backends.
# Actor: the Discord user ID of the service's bot user, recorded as granted_by.
INTEGRATION_GRANT_SECRET=
INTEGRATION_ACTOR_ID=
