# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local dev/deploy secrets
.dev.vars
!.dev.vars.example
.env.deploy

# 却下ロット除けのガード。OTOMOスウォーム/ヴィネットのスプライトは
# rights/RIGHTS-AND-IMAGE2-APPROVAL-20260729-001.json で不承認のため、
# assets/rejected/swarm-v002/ に退避してある（public/ に置くとビルドが
# dist/client へ写して本番から取得可能になる）。復活させるときは
# オーナー承認を得たうえで意図的に public/ へ戻すこと。
/public/dashboard-art/swarm/
