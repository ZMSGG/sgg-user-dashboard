#!/usr/bin/env python3
"""Preview or persist an immutable SGG project-state checkpoint."""

from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import tempfile
import uuid
from copy import deepcopy
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Mapping

from durable_state import (
    checkpoint_errors,
    checkpoint_for_state,
    load_json,
    meaningful,
    render_status,
    sha256_file,
    state_errors,
    write_json,
)


TOOL_VERSION = "1.0.0"


def safe_project_file(project_root: Path, relative: str) -> Path:
    candidate = (project_root / relative).resolve()
    try:
        candidate.relative_to(project_root.resolve())
    except ValueError as error:
        raise ValueError("changed path escapes project: {}".format(relative)) from error
    if Path(relative).is_absolute():
        raise ValueError("changed path must be relative: {}".format(relative))
    if not candidate.is_file():
        raise ValueError("changed path is not a file: {}".format(relative))
    return candidate


def validate_update(update: Mapping[str, Any]) -> List[str]:
    errors: List[str] = []
    if update.get("schema_version") != 1:
        errors.append("update schema_version must be 1")
    if not isinstance(update.get("expected_state_version"), int):
        errors.append("expected_state_version must be an integer")
    for key, minimum in (
        ("updated_by", 2),
        ("summary", 8),
        ("phase", 2),
        ("current_objective", 8),
    ):
        if not meaningful(update.get(key), minimum):
            errors.append("update {} is missing or not concrete".format(key))
    if update.get("status") not in {
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "LAUNCHED",
        "ARCHIVED",
        "BLOCKED",
    }:
        errors.append("update status is invalid")
    for key in ("active_work", "resume"):
        if not isinstance(update.get(key), dict):
            errors.append("update {} must be an object".format(key))
    for key in ("next_actions", "blockers", "changed_paths"):
        if not isinstance(update.get(key), list):
            errors.append("update {} must be an array".format(key))
    if "completed_actions" in update and not isinstance(
        update.get("completed_actions"), list
    ):
        errors.append("completed_actions must be an array")
    return errors


def next_state(
    project_root: Path,
    profile: Mapping[str, Any],
    current: Mapping[str, Any],
    update: Mapping[str, Any],
    updated_at: str,
) -> Dict[str, Any]:
    errors = validate_update(update)
    if errors:
        raise ValueError("; ".join(errors))
    if update["expected_state_version"] != current["state_version"]:
        raise ValueError(
            "state version conflict: expected {} but current is {}".format(
                update["expected_state_version"], current["state_version"]
            )
        )

    state = deepcopy(dict(current))
    version = current["state_version"] + 1
    checkpoint_id = "CP-{:06d}".format(version)
    completed = list(current.get("recently_completed", []))
    current_actions = {
        item.get("action_id"): item
        for item in current.get("next_actions", [])
        if isinstance(item, dict)
    }
    for item in update.get("completed_actions", []):
        if not isinstance(item, dict) or item.get("action_id") not in current_actions:
            raise ValueError("completed action must reference a current action_id")
        if not meaningful(item.get("result"), 6):
            raise ValueError("completed action requires a concrete result")
        completed.append(
            {
                "action_id": item["action_id"],
                "result": item["result"],
                "evidence": item.get("evidence", []),
                "completed_at": updated_at,
                "checkpoint_id": checkpoint_id,
            }
        )

    changed_files = []
    for item in update["changed_paths"]:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            raise ValueError("changed_paths entries require path")
        path = safe_project_file(project_root, item["path"])
        changed_files.append(
            {
                "path": item["path"],
                "sha256": sha256_file(path),
                "reason": item.get("reason") or update["summary"],
            }
        )

    state.update(
        {
            "state_version": version,
            "updated_at": updated_at,
            "updated_by": update["updated_by"],
            "status": update["status"],
            "phase": update["phase"],
            "current_objective": update["current_objective"],
            "last_summary": update["summary"],
            "last_checkpoint_id": checkpoint_id,
            "last_checkpoint_path": "checkpoints/{}.json".format(checkpoint_id),
            "active_work": update["active_work"],
            "recently_completed": completed[-25:],
            "next_actions": update["next_actions"],
            "blockers": update["blockers"],
            "decisions_needed": update.get(
                "decisions_needed", current.get("decisions_needed", [])
            ),
            "authorizations": update.get(
                "authorizations", current.get("authorizations", [])
            ),
            "changed_files": changed_files,
            "resume": update["resume"],
        }
    )
    errors = state_errors(state, profile["project_id"], project_root)
    if errors:
        raise ValueError("; ".join(errors))
    return state


def lock_project(project_root: Path, current: Mapping[str, Any]) -> Dict[str, Any]:
    lock_path = project_root / ".project-state.lock"
    lock = {
        "schema_version": 1,
        "authority": "SGG_PROJECT_STATE_LOCK",
        "project_id": current["project_id"],
        "base_state_version": current["state_version"],
        "pid": os.getpid(),
        "host": socket.gethostname(),
        "started_at": datetime.now().astimezone().replace(microsecond=0).isoformat(),
        "nonce": uuid.uuid4().hex,
        "tool_version": TOOL_VERSION,
    }
    try:
        descriptor = os.open(str(lock_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError as error:
        raise ValueError(
            "project state lock already exists; do not overwrite another writer"
        ) from error
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        json.dump(lock, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    return lock


def unlock_project(project_root: Path, lock: Mapping[str, Any]) -> None:
    lock_path = project_root / ".project-state.lock"
    try:
        current = load_json(lock_path)
    except ValueError:
        return
    if current.get("nonce") == lock.get("nonce"):
        lock_path.unlink()


def atomic_json(path: Path, value: Mapping[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".{}-".format(path.name), dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        temporary.replace(path)
        directory_descriptor = os.open(str(path.parent), os.O_RDONLY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


def persist_checkpoint(
    project_root: Path,
    profile: Mapping[str, Any],
    current: Mapping[str, Any],
    state: Mapping[str, Any],
    update: Mapping[str, Any],
) -> None:
    lock = lock_project(project_root, current)
    try:
        latest = load_json(project_root / "PROJECT_STATE.json")
        if latest.get("state_version") != update["expected_state_version"]:
            raise ValueError("state changed after preview; rerun with the new version")
        locked_state = next_state(
            project_root,
            profile,
            latest,
            update,
            str(state["updated_at"]),
        )
        if locked_state != state:
            raise ValueError("project files changed after preview; rerun the checkpoint")
        checkpoint_path = project_root / state["last_checkpoint_path"]
        if checkpoint_path.exists():
            raise ValueError("checkpoint already exists: {}".format(checkpoint_path))
        checkpoint = checkpoint_for_state(
            state,
            previous_checkpoint_id=current["last_checkpoint_id"],
            summary=update["summary"],
            project_root=project_root,
        )
        atomic_json(checkpoint_path, checkpoint)
        atomic_json(project_root / "PROJECT_STATE.json", state)
        (project_root / "STATUS.md").write_text(
            render_status(profile["title"], state), encoding="utf-8"
        )
        worklog = project_root / "WORKLOG.md"
        existing = worklog.read_text(encoding="utf-8") if worklog.is_file() else "# Worklog\n"
        summary = update["summary"].replace("|", "\\|").replace("\n", " ")
        line = "| {time} | `{checkpoint}` | {version} | {summary} | `{state_file}` |\n".format(
            time=state["updated_at"],
            checkpoint=state["last_checkpoint_id"],
            version=state["state_version"],
            summary=summary,
            state_file="PROJECT_STATE.json",
        )
        if not existing.endswith("\n"):
            existing += "\n"
        worklog.write_text(existing + line, encoding="utf-8")
    finally:
        unlock_project(project_root, lock)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project_root", type=Path)
    parser.add_argument("--update", type=Path, required=True)
    parser.add_argument("--updated-at", help="timezone-aware ISO-8601 timestamp")
    parser.add_argument("--write", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = args.project_root.expanduser().resolve()
    try:
        profile = load_json(project_root / "PROJECT_PROFILE.json")
        current = load_json(project_root / "PROJECT_STATE.json")
        update = load_json(args.update.expanduser().resolve())
        current_errors = state_errors(current, profile.get("project_id", ""), project_root)
        current_errors.extend(
            checkpoint_errors(project_root, current, allow_basis_drift=True)
        )
        if current_errors:
            raise ValueError("current state is invalid: {}".format("; ".join(current_errors)))
        updated_at = args.updated_at or datetime.now().astimezone().replace(microsecond=0).isoformat()
        state = next_state(project_root, profile, current, update, updated_at)
        print("SGG durable checkpoint preview")
        print("  Project: {}".format(profile["project_id"]))
        print("  Current state: {}".format(current["state_version"]))
        print("  Next state: {}".format(state["state_version"]))
        print("  Checkpoint: {}".format(state["last_checkpoint_id"]))
        print("  Objective: {}".format(state["current_objective"]))
        print("  Resume action: {}".format(state["resume"]["action_id"]))
        if not args.write:
            print("  Filesystem changed: no")
            return 0
        persist_checkpoint(project_root, profile, current, state, update)
    except (ValueError, OSError, KeyError, TypeError) as error:
        print("error: {}".format(error), file=sys.stderr)
        return 2
    print("Checkpoint written: {}".format(state["last_checkpoint_path"]))
    print("Validation report is now stale. Run validate_sgg_project.py --record.")
    return 0



