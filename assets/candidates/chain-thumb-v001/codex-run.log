/Users/zm/dev.vibe/sgg-user-dashboard/scripts/creative-pipeline/batch-01-cardfaces.json:6:   "command-center://SGG LP/sevengods-games/public/creator-kit/v1/assets/01_ebisu-taimaru/god/ebisu_main.webp",
